[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/quad_laser.gd" id="1_script"]
[ext_resource type="AudioStream" path="res://Assets/Audio/laser_gun_charge.ogg" id="2_charge"]
[ext_resource type="AudioStream" path="res://Assets/Audio/laser_gun_fire.ogg" id="3_fire"]

[node name="QuadLaser" type="Node2D"]
script = ExtResource("1_script")

[node name="ChargeSound" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("2_charge")
volume_db = -4.0
bus = &"SFX"

[node name="FireSound" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("3_fire")
bus = &"SFX"
