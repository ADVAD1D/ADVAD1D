[sub_resource type="GDScript" id="GDScript_pdsj5"]
script/source = "extends CanvasLayer

@export var menu_scene: PackedScene

@onready var unpause_button: TextureButton = %unPauseButton
@onready var quit_button: TextureButton = %QuitButton
@onready var decrease_button: TextureButton = %DecreaseButton
@onready var volume_label: Label = %VolumenPercentage
@onready var increase_button: TextureButton = %IncreaseButton
@onready var button_sound: AudioStreamPlayer = %ButtonSound
@onready var volume_hold_timer: Timer = $VolumeTimer

@onready var decrease_sfx_button: TextureButton = %DecreaseButtonSFX
@onready var increase_sfx_button: TextureButton = %IncreaseButtonSFX
@onready var volume_sfx_label: Label = %VolumenPercentageSFX

func _ready() -> void:
	unpause_button.pressed.connect(GameManager.toggle_pause)
	MusicPlayer.volume_changed.connect(_on_music_volume_changed)
	
	_on_music_volume_changed(MusicPlayer.get_volume_percent())
	GameManager.pause.connect(toggle_show)
	
	decrease_sfx_button.pressed.connect(SfxManager.decrease_sfx_volume)
	increase_sfx_button.pressed.connect(SfxManager.increase_sfx_volume)
	quit_button.pressed.connect(_on_quit_button_pressed)
	
	SfxManager.sfx_volume_changed.connect(_on_sfx_volume_changed)
	_on_sfx_volume_changed(SfxManager.get_sfx_volume_percent())
	
func _process(_delta: float) -> void:
	if volume_hold_timer.is_stopped():
		if decrease_button.is_pressed():
			MusicPlayer.decrease_volume()
			play_click_sound(MusicPlayer.volume_db)
			volume_hold_timer.start()
			
		elif increase_button.is_pressed():
			MusicPlayer.increase_volume()
			play_click_sound(MusicPlayer.volume_db)
			volume_hold_timer.start()
			
		elif decrease_sfx_button.is_pressed():
			SfxManager.decrease_sfx_volume()
			play_click_sound(AudioServer.get_bus_volume_db(SfxManager.sfx_bus_index))
			volume_hold_timer.start()
			
		elif increase_sfx_button.is_pressed():
			SfxManager.increase_sfx_volume()
			play_click_sound(AudioServer.get_bus_volume_db(SfxManager.sfx_bus_index))
			volume_hold_timer.start()
	
func play_click_sound(target_volume_db: float):
	if button_sound.playing:
		button_sound.stop()
		
	var player = AudioStreamPlayer.new()
	player.stream = button_sound.stream
	player.bus = 'Master'
	player.volume_db = target_volume_db
	player.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(player)
	player.play()
	player.finished.connect(player.queue_free)
	
func _on_sfx_volume_changed(sfx_percent: float):
	volume_sfx_label.text = str(int(round(sfx_percent))) + \"%\"
	
func _on_music_volume_changed(volume_percent: float):
	volume_label.text = str(int(round(volume_percent))) + \"%\"
	
func _on_quit_button_pressed():
	get_tree().paused = false
	get_tree().change_scene_to_packed(menu_scene)
	
func toggle_show(is_paused : bool) -> void :
	if is_paused:
		show()
		unpause_button.grab_focus()
	else:
		hide()

func _on_un_pause_button_mouse_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_quit_button_mouse_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_quit_button_focus_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_un_pause_button_focus_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_decrease_button_focus_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_increase_button_focus_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_decrease_button_sfx_focus_entered() -> void:
	button_sound.play() # Replace with function body.

func _on_increase_button_sfx_focus_entered() -> void:
	button_sound.play() # Replace with function body.
"

