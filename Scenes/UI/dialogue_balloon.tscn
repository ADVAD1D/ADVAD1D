[sub_resource type="Theme" id="Theme_dialogue"]
default_font = ExtResource("2_font")
default_font_size = 16
Button/colors/font_color = Color(0.75, 0.95, 0.95, 1)
Button/colors/font_disabled_color = Color(0.45, 0.45, 0.45, 1)
Button/colors/font_focus_color = Color(0, 1, 1, 1)
Button/colors/font_hover_color = Color(0, 1, 1, 1)
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_button_focus")
Button/styles/hover = SubResource("StyleBoxFlat_button_focus")
Button/styles/normal = SubResource("StyleBoxFlat_button")
Button/styles/pressed = SubResource("StyleBoxFlat_button_focus")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
RichTextLabel/colors/default_color = Color(0.9, 1, 1, 1)
RichTextLabel/constants/line_separation = -2

[sub_resource type="Animation" id="Animation_reset"]
length = 0.001
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Progress:position")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 0,
"values": [Vector2(0, 0)]
}

[sub_resource type="Animation" id="Animation_progress"]
resource_name = "progress"
length = 0.8
loop_mode = 1
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Progress:position")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.4),
"transitions": PackedFloat32Array(1, 1),
"update": 1,
"values": [Vector2(0, 0), Vector2(0, -2)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_progress"]
_data = {
&"RESET": SubResource("Animation_reset"),
&"progress": SubResource("Animation_progress")
}

[node name="DialogueBalloon" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1_script")

[node name="Balloon" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_dialogue")

[node name="PanelMargin" type="MarginContainer" parent="Balloon"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -74.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 6

[node name="PanelContainer" type="PanelContainer" parent="Balloon/PanelMargin"]
clip_children = 2
layout_mode = 2
mouse_filter = 1

[node name="HBoxContainer" type="HBoxContainer" parent="Balloon/PanelMargin/PanelContainer"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="VBoxContainer" type="VBoxContainer" parent="Balloon/PanelMargin/PanelContainer/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="CharacterLabel" type="RichTextLabel" parent="Balloon/PanelMargin/PanelContainer/HBoxContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_override_colors/default_color = Color(0, 1, 1, 1)
bbcode_enabled = true
text = "Character"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DialogueLabel" parent="Balloon/PanelMargin/PanelContainer/HBoxContainer/VBoxContainer" instance=ExtResource("3_label")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "Dialogue..."

[node name="ProgressHolder" type="Control" parent="Balloon/PanelMargin/PanelContainer/HBoxContainer"]
custom_minimum_size = Vector2(6, 6)
layout_mode = 2
size_flags_vertical = 8
mouse_filter = 2

[node name="Progress" type="Polygon2D" parent="Balloon/PanelMargin/PanelContainer/HBoxContainer/ProgressHolder"]
unique_name_in_owner = true
color = Color(0, 1, 1, 1)
polygon = PackedVector2Array(0, 0, 3, 4, 6, 0)

[node name="AnimationPlayer" type="AnimationPlayer" parent="Balloon/PanelMargin/PanelContainer/HBoxContainer/ProgressHolder"]
libraries = {
&"": SubResource("AnimationLibrary_progress")
}
autoplay = "progress"

[node name="ResponsesMenu" type="VBoxContainer" parent="Balloon" node_paths=PackedStringArray("response_template")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -120.0
offset_top = -130.0
offset_right = 120.0
offset_bottom = -84.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 2
alignment = 2
script = ExtResource("4_menu")
response_template = NodePath("ResponseExample")

[node name="ResponseExample" type="Button" parent="Balloon/ResponsesMenu"]
layout_mode = 2
text = "Response example"

[connection signal="gui_input" from="Balloon" to="." method="_on_balloon_gui_input"]
[connection signal="response_selected" from="Balloon/ResponsesMenu" to="." method="_on_responses_menu_response_selected"]
