# Spanish translation of ADVAD. The key (msgid) is the English text exactly as it appears
# in the scenes, scripts and resources; English is the default and needs no file.
# Names (ships, authors, GEMELA, ADNEX, achievement and shop item titles, colour names)
# are not translated on purpose. The secret chat console stays in English.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es\n"

# --- Commander dialogues (CinematicDialogue) ---------------------------------------------

msgid "COMMANDER"
msgstr "COMANDANTE"

# Abduction.tscn (abduction_scene.gd)
msgid "Welcome to the training program, soldier."
msgstr "Bienvenido al programa de entrenamiento, soldado."

msgid "This simulation is designed for you to learn and master the use of your ship."
msgstr "Esta simulación está diseñada para que aprendas y domines el uso de su nave."

msgid "You will face a series of challenges divided into 3 battle arenas, where you must clear 10 phases."
msgstr "Enfrentarás una serie de desafíos divididos en 3 arenas de batalla, donde deberás superar 10 fases."

msgid "Each phase has a set of enemies and a requirement to move on to the next one."
msgstr "Cada fase tiene un grupo de enemigos y un requisito para pasar a la siguiente."

msgid "It won't be easy."
msgstr "No será fácil."

msgid "To master the use of your unit, these trials will test your endurance,"
msgstr "Para dominar el uso de su unidad, estas pruebas medirán su resistencia,"

msgid "your handling of stress,"
msgstr "su manejo del estrés,"

msgid "and your reflexes."
msgstr "y sus reflejos."

msgid "Use the W, A, S, D keys or the arrow keys to move."
msgstr "Usa las teclas W, A, S, D o las flechas para moverte."

msgid "Press E to dash, which grants you 0.5 seconds of invulnerability."
msgstr "Pulsa E para hacer un dash, que te da 0,5 segundos de invulnerabilidad."

msgid "To shoot, use the F key or the space bar."
msgstr "Para disparar, usa la tecla F o la barra espaciadora."

msgid "Let's begin with arena 1."
msgstr "Empecemos con la arena 1."

# ending.tscn (after arena 1)
msgid "You have learned to deal with the 2 main types of bots: ships and saws."
msgstr "Has aprendido a lidiar con los 2 tipos de bots principales: las naves y las sierras."

msgid "They will be with you throughout this whole journey."
msgstr "Ellos te acompañarán por todo este recorrido."

msgid "The more you destroy in less time, the more your value as a key piece of the organization will rise."
msgstr "Mientras más destruyas en menos tiempo, su valor como pieza clave en la organización irá subiendo."

msgid "Get ready for the next arena."
msgstr "Prepárate para la próxima arena."

msgid "An enemy stuck to the walls will stalk you for a few phases."
msgstr "Un enemigo pegado a las paredes te acechará por unas cuantas fases."

msgid "You have to learn to dodge it while you destroy what is needed."
msgstr "Tienes que aprender a esquivarlo mientras destruyes lo necesario."

msgid "Let's begin with arena 2."
msgstr "Empecemos con la arena 2."

# test_room_cinematic.tscn (before arena 3)
msgid "Second test completed successfully, soldier."
msgstr "Segunda prueba superada con éxito, soldado."

msgid "We are impressed by the skill you have shown in the first two battle arenas."
msgstr "Estamos impresionados por la habilidad que ha demostrado en las dos primeras arenas de batalla."

msgid "What comes next will be the ultimate test: a deadly enemy."
msgstr "Lo que viene será la prueba definitiva: un enemigo mortal."

msgid "Not the simple robots you have been dealing with all this time."
msgstr "No los simples robots con los que ha lidiado todo este tiempo."

msgid "We want to guarantee excellence in this organization."
msgstr "Queremos garantizar la excelencia en esta organización."

msgid "Your results will be used to strengthen future trials for other soldiers."
msgstr "Sus resultados se usarán para reforzar las pruebas futuras de otros soldados."

msgid "We will collect your endurance, your reaction times, your behavior and your overall way of piloting."
msgstr "Recopilaremos su resistencia, sus tiempos de reacción, su comportamiento y su forma general de pilotar."

msgid "The simulator's artificial intelligence will improve based on the experiences and use of all of you."
msgstr "La inteligencia artificial del simulador mejorará con las experiencias y el uso de todos ustedes."

msgid "Handling your ship will always feel very close to the simulator experience."
msgstr "Manejar su nave siempre se sentirá muy parecido a la experiencia del simulador."

msgid "In the next phase of the trial, you will face a single threat."
msgstr "En la siguiente fase de la prueba, te enfrentarás a una única amenaza."

msgid "You need to put into practice everything you have learned so far."
msgstr "Necesitas poner en práctica todo lo que ha aprendido hasta ahora."

msgid "Good luck in arena 3."
msgstr "Buena suerte en la arena 3."

# monitor_cinematic.tscn (after arena 3)
msgid "Simulation complete. Congratulations on passing every trial."
msgstr "Simulación terminada. Felicidades por haber superado todas las pruebas."

msgid "You will now be sent to a real training test."
msgstr "Ahora será dirigido a una prueba de entrenamiento real."

msgid "SEND IN THE NEXT ONE!"
msgstr "¡QUE PASE EL SIGUIENTE!"

